VITE_API_BASE_URL=http://localhost:5047

# Google OAuth Web Client ID (Google Cloud Console > APIs & Services > Credentials).
# Must match the "Google:ClientId" the backend validates tokens against. Not a secret -
# Google Identity Services embeds it directly in the sign-in flow - but still not
# hardcoded, so it's easy to swap per environment.
VITE_GOOGLE_CLIENT_ID=

